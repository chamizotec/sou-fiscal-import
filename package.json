{
  "name": "sou-fiscal-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ficha de candidato e grafo de sinais de irregularidade nas eleicoes 2026.",
  "scripts": {
    "import": "node src/import.js",
    "import:ac": "node src/import.js --uf AC",
